generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// AUTHENTICATION & USER MANAGEMENT
// ==========================================

model User {
  id           String  @id @default(dbgenerated("(gen_random_uuid())::text"))
  email        String  @unique
  fullName     String
  phoneNumber  String?
  passwordHash String

  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?

  lastLoginAt       DateTime?
  passwordChangedAt DateTime?

  refreshTokenHash    String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  profilePictureUrl      String?
  profilePicturePublicId String?

  role     Role    @default(MEMBER)
  isActive Boolean @default(true)

  deletedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  createdById String?
  updatedById String?

  auditLogs               AuditLog[]
  blogPosts               BlogPost[]
  assignedMessages        ContactMessage[]
  uploadedMedia           MediaGallery[]           @relation("UserUploadedMedia")
  member                  Member?
  notifications           Notification[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  communications          Communication[]          @relation("UserCreatedCommunications")
  prayerRequestsSubmitted PrayerRequest[]          @relation("PrayerRequester")
  assignedPrayerRequests  PrayerRequest[]          @relation("PrayerAssignedTo")
  answeredPrayerRequests  PrayerRequest[]          @relation("PrayerAnsweredBy")
  prayerRequestNotes      PrayerRequestNote[]
  rsvps                   EventRsvp[]

  @@index([role])
  @@index([isActive])
}

model EmailVerificationToken {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([usedAt])
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([usedAt])
}

model AuditLog {
  id String @id @default(dbgenerated("(gen_random_uuid())::text"))

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  userEmail String?
  userRole  Role?

  action      String
  description String?

  entity   String?
  entityId String?

  method    String?
  endpoint  String?
  ipAddress String?
  userAgent String?

  statusCode Int?
  success    Boolean @default(true)

  oldValues Json?
  newValues Json?
  metadata  Json?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
}

// ==========================================
// MEMBER DIRECTORY & ORGANIZATIONAL STRUCTURE
// ==========================================

model Member {
  id              String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  firstName       String
  lastName        String
  otherName       String?
  email           String?
  phoneNumber     String?
  gender          Gender?
  dateOfBirth     DateTime?      @db.Timestamptz(6)
  maritalStatus   MaritalStatus?
  address         String?
  occupation      String?
  baptismalStatus String?
  isWorker        Boolean        @default(false)
  userId          String?        @unique

  receiveEmailNotifications Boolean @default(true)
  receiveSmsNotifications   Boolean @default(false)

  deletedAt   DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  createdById String?
  updatedById String?

  user                    User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  attendances             Attendance[]
  ledDepartments          Department[]
  departments             DepartmentMember[]
  ledMinistries           Ministry[]               @relation("MinistryPrimaryLeader")
  ministryMemberships     MinistryMember[]
  givings                 Giving[]
  facilitatedClasses      LeadershipClass[]
  enrollments             LeadershipEnrollment[]
  worker                  Worker?
  workerTrainings         WorkerInTraining[]       @relation("MemberTraining")
  mentees                 WorkerInTraining[]       @relation("Mentorship")
  communicationRecipients CommunicationRecipient[]
  subscribers             Subscriber[]
  prayerRequests          PrayerRequest[]
  rsvps                   EventRsvp[]

  @@index([lastName])
  @@index([email])
  @@index([phoneNumber])
}

model Department {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  name        String    @unique
  slug        String    @unique
  description String?
  leaderId    String?
  deletedAt   DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  createdById String?
  updatedById String?

  leader   Member?                 @relation(fields: [leaderId], references: [id], onDelete: SetNull)
  metrics  DepartmentMetric[]
  entries  DepartmentMetricEntry[]
  members  DepartmentMember[]
  workers  Worker[]
  trainees WorkerInTraining[]
}

model DepartmentMetric {
  id           String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  title       String
  weight      Float
  targetValue Float

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  entries DepartmentMetricEntry[]

  @@index([departmentId])
}

model DepartmentMetricEntry {
  id String @id @default(dbgenerated("(gen_random_uuid())::text"))

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  metricId String
  metric   DepartmentMetric @relation(fields: [metricId], references: [id], onDelete: Cascade)

  achievedValue Float
  period        String

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([departmentId, metricId, period])
  @@index([departmentId])
  @@index([metricId])
  @@index([period])
}

model DepartmentMember {
  id           String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  memberId     String
  departmentId String
  role         DepartmentRole   @default(MEMBER)
  status       DepartmentStatus @default(ACTIVE)
  joinedAt     DateTime         @default(now()) @db.Timestamptz(6)
  leftAt       DateTime?        @db.Timestamptz(6)
  deletedAt    DateTime?        @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  createdById  String?
  updatedById  String?

  department      Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  member          Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  workerTrainings WorkerInTraining[]

  @@unique([memberId, departmentId])
  @@index([departmentId])
  @@index([memberId])
}

model Ministry {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  name        String    @unique
  slug        String    @unique
  description String?
  leaderId    String?
  deletedAt   DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  createdById String?
  updatedById String?

  leader         Member?          @relation("MinistryPrimaryLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  members        MinistryMember[]
  leaderWorkerId String?

  // Opposite side of the "MinistryLeaderWorker" relation
  leaderWorker Worker?  @relation("MinistryLeaderWorker", fields: [leaderWorkerId], references: [id], onDelete: SetNull)
  workers      Worker[] @relation("MinistryWorkers")

  @@index([leaderId])
}

model MinistryMember {
  id          String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  memberId    String
  ministryId  String
  roleTitle   String           @default("Member")
  isLeader    Boolean          @default(false)
  status      DepartmentStatus @default(ACTIVE)
  joinedAt    DateTime         @default(now()) @db.Timestamptz(6)
  leftAt      DateTime?        @db.Timestamptz(6)
  deletedAt   DateTime?        @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  createdById String?
  updatedById String?

  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  ministry Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)

  @@unique([memberId, ministryId])
  @@index([ministryId])
  @@index([memberId])
}

model Worker {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  memberId     String    @unique
  departmentId String?
  ministryId   String?
  position     String?
  isActive     Boolean   @default(true)
  joinedAt     DateTime  @default(now()) @db.Timestamptz(6)
  deletedAt    DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  department      Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  member          Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  ministry        Ministry?          @relation("MinistryWorkers", fields: [ministryId], references: [id], onDelete: SetNull)
  leadsMinistry   Ministry[]         @relation("MinistryLeaderWorker")
  attendances     WorkerAttendance[]
  trainingMentees WorkerInTraining[] @relation("WorkerMentorship")

  @@index([memberId])
  @@index([departmentId])
  @@index([ministryId])
}

model WorkerAttendance {
  id        String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  workerId  String
  date      DateTime         @db.Timestamptz(6)
  status    AttendanceStatus
  createdAt DateTime         @default(now()) @db.Timestamptz(6)

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, date])
}

model LeadershipClass {
  id            String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  name          String
  description   String?
  level         LeadershipLevel @default(BASIC)
  startDate     DateTime?       @db.Timestamptz(6)
  endDate       DateTime?       @db.Timestamptz(6)
  isActive      Boolean         @default(true)
  facilitatorId String?
  deletedAt     DateTime?       @db.Timestamptz(6)
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime        @default(now()) @updatedAt @db.Timestamptz(6)

  facilitator Member?                @relation(fields: [facilitatorId], references: [id], onDelete: SetNull)
  enrollments LeadershipEnrollment[]
  sessions    LeadershipSession[]
  trainees    WorkerInTraining[]

  @@index([facilitatorId])
}

model LeadershipSession {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  classId     String
  title       String?
  scheduledAt DateTime @db.Timestamptz(6)
  location    String?
  meetingLink String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  class LeadershipClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([scheduledAt])
  @@index([classId])
}

model LeadershipEnrollment {
  id          String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  classId     String
  memberId    String
  status      EnrollmentStatus @default(IN_PROGRESS)
  progress    Int              @default(0)
  enrolledAt  DateTime         @default(now()) @db.Timestamptz(6)
  completedAt DateTime?        @db.Timestamptz(6)

  class  LeadershipClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  member Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([classId, memberId])
  @@index([memberId])
  @@index([classId])
}

model WorkerInTraining {
  id                 String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  memberId           String
  departmentId       String
  departmentMemberId String?
  stage              WorkerTrainingStage @default(APPLIED)
  leadershipClassId  String?
  mentorId           String?
  mentorWorkerId     String?
  notes              String?
  startDate          DateTime            @default(now()) @db.Timestamptz(6)
  isActive           Boolean             @default(true)
  deletedAt          DateTime?           @db.Timestamptz(6)
  completedAt        DateTime?           @db.Timestamptz(6)
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime            @default(now()) @updatedAt @db.Timestamptz(6)

  department       Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentMember DepartmentMember? @relation(fields: [departmentMemberId], references: [id], onDelete: SetNull)
  leadershipClass  LeadershipClass?  @relation(fields: [leadershipClassId], references: [id], onDelete: SetNull)
  member           Member            @relation("MemberTraining", fields: [memberId], references: [id], onDelete: Cascade)
  mentor           Member?           @relation("Mentorship", fields: [mentorId], references: [id], onDelete: SetNull)
  mentorWorker     Worker?           @relation("WorkerMentorship", fields: [mentorWorkerId], references: [id], onDelete: SetNull)

  @@index([memberId])
  @@index([departmentId])
  @@index([stage])
}

// ==========================================
// EVENTS, MEDIA & BLOGS
// ==========================================

model Event {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  title       String
  description String?
  location    String?
  startDate   DateTime  @db.Timestamptz(6)
  endDate     DateTime? @db.Timestamptz(6)
  bannerImage String?
  isPublished Boolean   @default(false)
  deletedAt   DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  createdById String?
  updatedById String?

  attendances Attendance[]
  media       MediaGallery[]
  rsvps       EventRsvp[]

  @@index([startDate])
}

model EventRsvp {
  id       String  @id @default(dbgenerated("(gen_random_uuid())::text"))
  eventId  String
  userId   String?
  memberId String?

  fullName    String?
  email       String?
  phoneNumber String?

  status    RsvpStatus @default(CONFIRMED)
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @db.Timestamptz(6)

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@unique([eventId, userId])
  @@unique([eventId, memberId])
  @@index([eventId])
  @@index([userId])
  @@index([memberId])
}

model Attendance {
  id        String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  memberId  String
  eventId   String
  status    AttendanceStatus @default(PRESENT)
  createdAt DateTime         @default(now()) @db.Timestamptz(6)

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, eventId])
  @@index([eventId])
  @@index([memberId])
}

model BlogPost {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  title       String
  slug        String    @unique
  content     String
  excerpt     String?
  coverImage  String?
  isPublished Boolean   @default(false)
  authorId    String?
  publishedAt DateTime? @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  createdById String?
  updatedById String?

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([isPublished])
  @@index([authorId])
}

model Sermon {
  id            String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  title         String
  preacher      String
  scriptureText String?
  summary       String?
  videoUrl      String?
  audioUrl      String?
  thumbnailUrl  String?
  sermonDate    DateTime  @db.Timestamptz(6)
  deletedAt     DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([sermonDate])
}

model MediaGallery {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  title        String
  type         MediaType
  url          String
  thumbnail    String?
  description  String?
  eventId      String?
  uploadedById String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)

  event      Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  uploadedBy User?  @relation("UserUploadedMedia", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([eventId])
}

// ==========================================
// FINANCE & GIVING
// ==========================================

model Giving {
  id            String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  memberId      String?
  amount        Decimal        @db.Decimal(12, 2)
  type          GivingType
  reference     String?        @unique
  paymentMethod PaymentMethod?
  notes         String?
  deletedAt     DateTime?      @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)

  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([memberId])
  @@index([createdAt])
}

// ==========================================
// COMMUNICATIONS & NOTIFICATIONS
// ==========================================

model Notification {
  id        String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  userId    String?
  createdAt DateTime         @default(now()) @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Communication {
  id              String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  title           String
  subject         String?
  content         String
  type            CommunicationType
  status          CommunicationStatus
  prayerRequestId String?
  scheduledAt     DateTime?           @db.Timestamptz(6)
  sentAt          DateTime?           @db.Timestamptz(6)
  deletedAt       DateTime?           @db.Timestamptz(6)
  archivedAt      DateTime?           @db.Timestamptz(6)
  metadata        Json?               @default("{}")

  createdById String
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  createdBy     User                     @relation("UserCreatedCommunications", fields: [createdById], references: [id])
  prayerRequest PrayerRequest?           @relation(fields: [prayerRequestId], references: [id], onDelete: SetNull)
  channels      CommunicationChannel[]
  recipients    CommunicationRecipient[]
  logs          CommunicationLog[]

  @@index([createdById])
  @@index([status])
}

model CommunicationRecipient {
  id              String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  communicationId String
  memberId        String?
  subscriberId    String?
  email           String?
  phone           String?
  status          RecipientStatus @default(PENDING)
  sentAt          DateTime?       @db.Timestamptz(6)

  communication Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  member        Member?       @relation(fields: [memberId], references: [id], onDelete: SetNull)
  subscriber    Subscriber?   @relation(fields: [subscriberId], references: [id], onDelete: SetNull)

  @@index([communicationId])
  @@index([memberId])
  @@index([subscriberId])
}

model CommunicationLog {
  id              String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  communicationId String
  channel         CommunicationChannel
  success         Boolean
  response        String?
  createdAt       DateTime             @default(now()) @db.Timestamptz(6)

  communication Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@index([communicationId])
}


model WebAnalyticsVisitor {
  id          String   @id @default(cuid())
  visitorId   String   @unique
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  sessions WebAnalyticsSession[]
  events   WebAnalyticsEvent[]

  @@index([lastSeenAt])
}

model WebAnalyticsSession {
  id        String   @id @default(cuid())
  sessionId String   @unique
  visitorId String

  startedAt DateTime @default(now())
  lastSeenAt DateTime @default(now())

  ipHash    String?
  userAgent String?
  country   String?
  city      String?
  device    String?
  browser   String?
  os        String?
  referrer  String?

  visitor WebAnalyticsVisitor @relation(fields: [visitorId], references: [visitorId], onDelete: Cascade)

  events WebAnalyticsEvent[]

  @@index([visitorId])
  @@index([startedAt])
  @@index([lastSeenAt])
}

model WebAnalyticsEvent {
  id String @id @default(cuid())

  event     String
  path      String?
  title     String?
  url       String?
  createdAt DateTime @default(now())

  visitorId String?
  sessionId String?

  visitor WebAnalyticsVisitor? @relation(fields: [visitorId], references: [visitorId], onDelete: SetNull)

  session WebAnalyticsSession? @relation(fields: [sessionId], references: [sessionId], onDelete: SetNull)

  @@index([createdAt])
  @@index([event])
  @@index([visitorId])
  @@index([sessionId])
  @@index([path])
}
model Subscriber {
  id               String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  firstName        String?
  lastName         String?
  email            String?   @unique
  phoneNumber      String?
  receiveEmail     Boolean   @default(true)
  receiveSms       Boolean   @default(false)
  receiveWhatsapp  Boolean   @default(false)
  isActive         Boolean   @default(true)
  unsubscribeToken String    @unique @default(dbgenerated("(gen_random_uuid())::text"))
  memberId         String?
  subscribedAt     DateTime  @default(now()) @db.Timestamptz(6)
  unsubscribedAt   DateTime? @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  member                  Member?                  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  communicationRecipients CommunicationRecipient[]

  @@index([phoneNumber])
  @@index([isActive])
}

model ContactMessage {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  fullName     String
  email        String
  phoneNumber  String?
  subject      String
  message      String
  isResolved   Boolean   @default(false)
  resolvedAt   DateTime? @db.Timestamptz(6)
  isRead       Boolean   @default(false)
  assignedToId String?
  deletedAt    DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)

  assignedTo User? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([isResolved])
  @@index([isRead])
  @@index([assignedToId])
  @@index([deletedAt])
}

model Invitation {
  id         String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  email      String       @unique
  role       InviteRole   @default(MEMBER)
  token      String       @unique
  status     InviteStatus @default(PENDING)
  expiresAt  DateTime     @db.Timestamptz(6)
  createdAt  DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(6)
  acceptedAt DateTime?    @db.Timestamptz(6)

  @@index([token])
}

// ==========================================
// PRAYER REQUESTS & SYSTEM SETTINGS
// ==========================================

model PrayerRequest {
  id                     String                  @id @default(dbgenerated("(gen_random_uuid())::text"))
  requesterId            String?
  memberId               String?
  firstName              String?
  lastName               String?
  email                  String?
  phoneNumber            String?
  subject                String
  message                String
  category               PrayerRequestCategory   @default(OTHER)
  visibility             PrayerRequestVisibility @default(PRIVATE)
  priority               PrayerRequestPriority   @default(NORMAL)
  isConfidential         Boolean                 @default(true)
  internalSummary        String?
  testimony              String?
  allowFollowUp          Boolean                 @default(true)
  preferredContactMethod String?
  followUpSent           Boolean                 @default(false)
  status                 PrayerRequestStatus     @default(PENDING)
  assignedToId           String?
  answeredById           String?
  answeredAt             DateTime?               @db.Timestamptz(6)
  acknowledgedAt         DateTime?               @db.Timestamptz(6)
  closedAt               DateTime?               @db.Timestamptz(6)
  deletedAt              DateTime?               @db.Timestamptz(6)
  createdAt              DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                @default(now()) @updatedAt @db.Timestamptz(6)

  requester      User?               @relation("PrayerRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  member         Member?             @relation(fields: [memberId], references: [id], onDelete: SetNull)
  assignedTo     User?               @relation("PrayerAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  answeredBy     User?               @relation("PrayerAnsweredBy", fields: [answeredById], references: [id], onDelete: SetNull)
  notes          PrayerRequestNote[]
  communications Communication[]

  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([memberId])
  @@index([requesterId])
  @@index([email])        // <--- ADD THIS: Fast lookup for non-member requests by email
  @@index([phoneNumber])
}

model PrayerRequestNote {
  id              String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  prayerRequestId String
  authorId        String?
  note            String
  isInternal      Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  prayerRequest PrayerRequest @relation(fields: [prayerRequestId], references: [id], onDelete: Cascade)
  author        User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([prayerRequestId])
  @@index([authorId])
}

model SystemSetting {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  key         String   @unique
  value       Json
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  updatedById String?

  @@index([key])
}

