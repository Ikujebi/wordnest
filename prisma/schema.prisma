generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String  @id @default(dbgenerated("(gen_random_uuid())::text"))
  email       String  @unique
  fullName    String
  phoneNumber String?

  passwordHash String

  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?

  lastLoginAt       DateTime?
  passwordChangedAt DateTime?

  refreshTokenHash    String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  profilePictureUrl      String?
  profilePicturePublicId String?

  role     Role    @default(MEMBER)
  isActive Boolean @default(true)

  deletedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  createdById String?
  updatedById String?

  auditLogs        AuditLog[]
  blogPosts        BlogPost[]
  assignedMessages ContactMessage[]
  uploadedMedia    MediaGallery[]   @relation("UserUploadedMedia")
  member           Member?
  notifications    Notification[]

  // 🔥 ADD THESE TWO LINES
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  // 🔥 ADD THIS LINE INSIDE THE USER MODEL
  communications Communication[]
  prayerRequestsSubmitted PrayerRequest[]     @relation("PrayerRequester")
  assignedPrayerRequests  PrayerRequest[]     @relation("PrayerAssignedTo")
  answeredPrayerRequests  PrayerRequest[]     @relation("PrayerAnsweredBy")
  prayerRequestNotes      PrayerRequestNote[]

  @@index([role])
  @@index([isActive])
}

model AuditLog {
  id String @id @default(dbgenerated("(gen_random_uuid())::text"))

  // User
  userId String?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  userEmail String?
  userRole  Role?

  // Action
  action      String
  description String?

  // Resource
  entity   String?
  entityId String?

  // Request
  method    String?
  endpoint  String?
  ipAddress String?
  userAgent String?

  // Response
  statusCode Int?
  success    Boolean @default(true)

  // Changes
  oldValues Json?
  newValues Json?

  // Extra metadata
  metadata Json?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
}

model EmailVerificationToken {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([usedAt])
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([usedAt])
}

model Member {
  id                      String                   @id @default(dbgenerated("(gen_random_uuid())::text"))
  firstName               String
  lastName                String
  otherName               String?
  email                   String?
  phoneNumber             String?
  gender                  Gender?
  dateOfBirth             DateTime?                @db.Timestamptz(6)
  maritalStatus           MaritalStatus?
  address                 String?
  occupation              String?
  baptismalStatus         String?
  isWorker                Boolean                  @default(false)
  userId                  String?                  @unique
  deletedAt               DateTime?                @db.Timestamptz(6)
  createdAt               DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                 @default(now()) @updatedAt @db.Timestamptz(6)
  createdById             String?
  updatedById             String?
  attendances             Attendance[]
  ledDepartments          Department[]
  departments             DepartmentMember[]
  givings                 Giving[]
  facilitatedClasses      LeadershipClass[]
  enrollments             LeadershipEnrollment[]
  user                    User?                    @relation(fields: [userId], references: [id])
  worker                  Worker?
  workerTrainings         WorkerInTraining[]       @relation("MemberTraining")
  mentees                 WorkerInTraining[]       @relation("Mentorship")
  communicationRecipients CommunicationRecipient[]
  subscribers             Subscriber[]
  prayerRequests PrayerRequest[]
  @@index([lastName])
}

model Department {
  id          String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  name        String             @unique
  metrics     DepartmentMetric[]
  entries     DepartmentMetricEntry[]
  slug        String             @unique
  description String?
  leaderId    String?
  deletedAt   DateTime?          @db.Timestamptz(6)
  createdAt   DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  createdById String?
  updatedById String?
  leader      Member?            @relation(fields: [leaderId], references: [id])
  members     DepartmentMember[]
  workers     Worker[]
  trainees    WorkerInTraining[]
}
model DepartmentMetric {
  id           String   @id @default(uuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  
  title        String   // e.g., "Weekly Attendance Target", "Worker Conversion"
  weight       Float    // Weight towards 100% total (e.g., 40 for 40%)
  targetValue  Float    // Expected 100% mark (e.g., 50 members)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  entries      DepartmentMetricEntry[]
}

model DepartmentMetricEntry {
  id             String           @id @default(uuid())

  departmentId   String
  department     Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  metricId       String
  metric         DepartmentMetric @relation(fields: [metricId], references: [id], onDelete: Cascade)

  achievedValue  Float
  period         String

  createdAt      DateTime @default(now())

  @@unique([departmentId, metricId, period])
  @@index([departmentId])
  @@index([metricId])
  @@index([period])
}
model DepartmentMember {
  id              String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  memberId        String
  departmentId    String
  role            DepartmentRole     @default(MEMBER)
  status          DepartmentStatus   @default(ACTIVE)
  joinedAt        DateTime           @default(now()) @db.Timestamptz(6)
  leftAt          DateTime?          @db.Timestamptz(6)
  deletedAt       DateTime?          @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  createdById     String?
  updatedById     String?
  department      Department         @relation(fields: [departmentId], references: [id])
  member          Member             @relation(fields: [memberId], references: [id])
  workerTrainings WorkerInTraining[]

  @@unique([memberId, departmentId])
  @@index([departmentId])
  @@index([memberId])
}

model Event {
  id          String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  title       String
  description String?
  location    String?
  startDate   DateTime       @db.Timestamptz(6)
  endDate     DateTime?      @db.Timestamptz(6)
  bannerImage String?
  isPublished Boolean        @default(false)
  deletedAt   DateTime?      @db.Timestamptz(6)
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  createdById String?
  updatedById String?
  attendances Attendance[]
  media       MediaGallery[]

  @@index([startDate])
}

model Attendance {
  id        String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  memberId  String
  eventId   String
  status    AttendanceStatus @default(PRESENT)
  createdAt DateTime         @default(now()) @db.Timestamptz(6)
  event     Event            @relation(fields: [eventId], references: [id])
  member    Member           @relation(fields: [memberId], references: [id])

  @@unique([memberId, eventId])
  @@index([eventId])
}

model Giving {
  id            String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  memberId      String?
  amount        Decimal        @db.Decimal(12, 2)
  type          GivingType
  reference     String?        @unique
  paymentMethod PaymentMethod?
  notes         String?
  deletedAt     DateTime?      @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  member        Member?        @relation(fields: [memberId], references: [id])

  @@index([type])
}

model BlogPost {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  title       String
  slug        String    @unique
  content     String
  excerpt     String?
  coverImage  String?
  isPublished Boolean   @default(false)
  authorId    String?
  publishedAt DateTime? @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  createdById String?
  updatedById String?
  author      User?     @relation(fields: [authorId], references: [id])

  @@index([isPublished])
}

model Sermon {
  id            String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  title         String
  preacher      String
  scriptureText String?
  summary       String?
  videoUrl      String?
  audioUrl      String?
  thumbnailUrl  String?
  sermonDate    DateTime  @db.Timestamptz(6)
  deletedAt     DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([sermonDate])
}

model MediaGallery {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  title        String
  type         MediaType
  url          String
  thumbnail    String?
  description  String?
  eventId      String?
  uploadedById String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  event        Event?    @relation(fields: [eventId], references: [id])
  uploadedBy   User?     @relation("UserUploadedMedia", fields: [uploadedById], references: [id])

  @@index([type])
}

model Notification {
  id        String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  userId    String?
  createdAt DateTime         @default(now()) @db.Timestamptz(6)
  user      User?            @relation(fields: [userId], references: [id])

  @@index([userId])
}

model ContactMessage {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  fullName     String
  email        String
  phoneNumber  String?
  subject      String
  message      String
  isResolved   Boolean   @default(false)
  isRead       Boolean   @default(false)
  assignedToId String?
  deletedAt    DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  assignedTo   User?     @relation(fields: [assignedToId], references: [id])
  @@index([createdAt])
  @@index([isResolved])
  @@index([isRead])
  @@index([assignedToId])
  @@index([deletedAt])
}

model Ministry {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  name        String    @unique
  description String?
  leaderId    String?   @unique
  deletedAt   DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  leader      Worker?   @relation("MinistryLeader", fields: [leaderId], references: [id])
  workers     Worker[]  @relation("MinistryWorkers")
}

model Worker {
  id              String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  memberId        String             @unique
  departmentId    String?
  ministryId      String?
  position        String?
  isActive        Boolean            @default(true)
  joinedAt        DateTime           @default(now()) @db.Timestamptz(6)
  deletedAt       DateTime?          @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  leadsMinistry   Ministry?          @relation("MinistryLeader")
  department      Department?        @relation(fields: [departmentId], references: [id])
  member          Member             @relation(fields: [memberId], references: [id])
  ministry        Ministry?          @relation("MinistryWorkers", fields: [ministryId], references: [id])
  attendances     WorkerAttendance[]
  trainingMentees WorkerInTraining[] @relation("WorkerMentorship")

  @@index([departmentId])
}

model WorkerAttendance {
  id        String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  workerId  String
  date      DateTime         @db.Timestamptz(6)
  status    AttendanceStatus
  createdAt DateTime         @default(now()) @db.Timestamptz(6)
  worker    Worker           @relation(fields: [workerId], references: [id])

  @@unique([workerId, date])
}

model LeadershipClass {
  id            String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  name         String
  description   String?
  level         LeadershipLevel        @default(BASIC)
  startDate     DateTime?              @db.Timestamptz(6)
  endDate       DateTime?              @db.Timestamptz(6)
  isActive      Boolean                @default(true)
  facilitatorId String?
  deletedAt     DateTime?              @db.Timestamptz(6)
  createdAt     DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime               @default(now()) @updatedAt @db.Timestamptz(6)
  facilitator   Member?                @relation(fields: [facilitatorId], references: [id])
  enrollments   LeadershipEnrollment[]
  sessions      LeadershipSession[]
  trainees      WorkerInTraining[]
}

model LeadershipSession {
  id          String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  classId     String
  title       String?
  scheduledAt DateTime        @db.Timestamptz(6)
  location    String?
  meetingLink String?
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)
  class       LeadershipClass @relation(fields: [classId], references: [id])

  @@index([scheduledAt])
}

model LeadershipEnrollment {
  id          String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  classId     String
  memberId    String
  status      EnrollmentStatus @default(IN_PROGRESS)
  progress    Int              @default(0)
  enrolledAt  DateTime         @default(now()) @db.Timestamptz(6)
  completedAt DateTime?        @db.Timestamptz(6)
  class       LeadershipClass  @relation(fields: [classId], references: [id])
  member      Member           @relation(fields: [memberId], references: [id])

  @@unique([classId, memberId])
}

model WorkerInTraining {
  id                 String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  memberId           String
  departmentId       String
  departmentMemberId String?
  stage              WorkerTrainingStage @default(APPLIED)
  leadershipClassId  String?
  mentorId           String?
  mentorWorkerId     String?
  notes              String?
  startDate          DateTime            @default(now()) @db.Timestamptz(6)
  isActive           Boolean             @default(true)
  deletedAt          DateTime?           @db.Timestamptz(6)
  completedAt        DateTime?           @db.Timestamptz(6)
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  department         Department          @relation(fields: [departmentId], references: [id])
  departmentMember   DepartmentMember?   @relation(fields: [departmentMemberId], references: [id])
  leadershipClass    LeadershipClass?    @relation(fields: [leadershipClassId], references: [id])
  member             Member              @relation("MemberTraining", fields: [memberId], references: [id])
  mentor             Member?             @relation("Mentorship", fields: [mentorId], references: [id])
  mentorWorker       Worker?             @relation("WorkerMentorship", fields: [mentorWorkerId], references: [id])

  @@index([departmentId])
  @@index([stage])
}

model Communication {
  id String @id @default(uuid())

  title   String
  subject String?
  content String

  type   CommunicationType
  status CommunicationStatus
  prayerRequestId String?
  prayerRequest   PrayerRequest? @relation(fields: [prayerRequestId], references: [id])
  scheduledAt DateTime?
  sentAt      DateTime?

  // 🔥 ADD THESE TWO LINES HERE:
  deletedAt  DateTime? @db.Timestamptz(6)
  archivedAt DateTime? @db.Timestamptz(6)

  metadata Json? @default("{}")

  createdById String
  createdBy   User                   @relation(fields: [createdById], references: [id])
  channels    CommunicationChannel[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  recipients CommunicationRecipient[]
  logs       CommunicationLog[]
}

model CommunicationRecipient {
  id String @id @default(uuid())

  communicationId String

  memberId String?

  subscriberId String?

  email String?

  phone String?

  status RecipientStatus @default(PENDING)

  sentAt DateTime?

  communication Communication @relation(fields: [communicationId], references: [id])

  member Member? @relation(fields: [memberId], references: [id])

  subscriber Subscriber? @relation(fields: [subscriberId], references: [id])

  @@index([communicationId])
  @@index([memberId])
  @@index([subscriberId])
}

model CommunicationLog {
  id String @id @default(uuid())

  communicationId String

  channel CommunicationChannel

  success Boolean

  response String?

  createdAt DateTime @default(now())

  communication Communication @relation(fields: [communicationId], references: [id])
}

model Subscriber {
  id String @id @default(uuid())

  firstName String?
  lastName  String?

  email       String? @unique
  phoneNumber String?

  // Communication preferences
  receiveEmail    Boolean @default(true)
  receiveSms      Boolean @default(false)
  receiveWhatsapp Boolean @default(false)

  isActive                Boolean                  @default(true)
  communicationRecipients CommunicationRecipient[]
  // Used for public unsubscribe links
  unsubscribeToken        String                   @unique @default(uuid())

  // Optional link if subscriber later becomes a church member
  memberId String?
  member   Member? @relation(fields: [memberId], references: [id])

  subscribedAt DateTime @default(now()) @db.Timestamptz(6)

  unsubscribedAt DateTime?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([phoneNumber])
  @@index([isActive])
}

model Invitation {
  id          String       @id @default(uuid())
  email       String       @unique
  role        InviteRole   @default(MEMBER)
  token       String       @unique
  status      InviteStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  acceptedAt  DateTime?

  @@index([token])
}
model PrayerRequest {
  id                     String                  @id @default(uuid())
  requesterId            String?                 // if logged-in member/user
  memberId               String?                 // if linked to church member
  firstName              String?
  lastName               String?
  email                  String?
  phoneNumber            String?
  subject                String
  message                String
  category               PrayerRequestCategory   @default(OTHER)
  visibility             PrayerRequestVisibility @default(PRIVATE)
  priority               PrayerRequestPriority   @default(NORMAL)
  isConfidential         Boolean                 @default(true)

  // DTO support fields
  internalSummary        String?
  testimony              String?
  allowFollowUp          Boolean                 @default(true)
  preferredContactMethod String?
  followUpSent           Boolean                 @default(false)

  status                 PrayerRequestStatus     @default(PENDING)

  assignedToId           String?
  answeredById           String?
  answeredAt             DateTime?
  acknowledgedAt         DateTime?
  closedAt               DateTime?

  deletedAt              DateTime?               @db.Timestamptz(6)
  createdAt              DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                @default(now()) @updatedAt @db.Timestamptz(6)

  requester              User?                   @relation("PrayerRequester", fields: [requesterId], references: [id])
  member                 Member?                 @relation(fields: [memberId], references: [id])
  assignedTo             User?                   @relation("PrayerAssignedTo", fields: [assignedToId], references: [id])
  answeredBy             User?                   @relation("PrayerAnsweredBy", fields: [answeredById], references: [id])

  notes                  PrayerRequestNote[]
  communications         Communication[]

  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([memberId])
  @@index([requesterId])
}
model PrayerRequestNote {
  id            String        @id @default(uuid())
  prayerRequestId String
  authorId      String?
  note          String
  isInternal    Boolean       @default(true)

  createdAt     DateTime      @default(now()) @db.Timestamptz(6)

  prayerRequest PrayerRequest  @relation(fields: [prayerRequestId], references: [id], onDelete: Cascade)
  author        User?         @relation(fields: [authorId], references: [id])

  @@index([prayerRequestId])
  @@index([authorId])
}
model SystemSetting {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  key         String   @unique
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@index([key])
}
enum Gender {
  MALE
  FEMALE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum NotificationType {
  SYSTEM
  EVENT
  SERMON
  ANNOUNCEMENT
  PRAYER
  WARNING
  INFO
  SUCCESS
}

enum PaymentMethod {
  CASH
  TRANSFER
  POS
  ONLINE
}

enum GivingType {
  TITHE
  OFFERING
  THANKSGIVING
  BUILDING_FUND
  MISSION
  PARTNERSHIP
  DONATION
  OTHER
}

enum PrayerStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum CounsellingStatus {
  PENDING
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum VolunteerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FollowUpStatus {
  PENDING
  CONTACTED
  DISCIPLED
  JOINED_CHURCH
}

enum StreamPlatform {
  YOUTUBE
  FACEBOOK
  MIXLR
  CUSTOM
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

enum LeadershipLevel {
  BASIC
  INTERMEDIATE
  ADVANCED
}

enum EnrollmentStatus {
  IN_PROGRESS
  COMPLETED
  DROPPED
}

enum WorkerTrainingStage {
  APPLIED
  INTERVIEWED
  LEADERSHIP_CLASS
  DEPARTMENT_ORIENTATION
  ACTIVE_WORKER
  PAUSED
  REJECTED
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
  TRANSFERRED
  SUSPENDED
}

enum DepartmentRole {
  MEMBER
  LEADER
  ASSISTANT_LEADER
  SECRETARY
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MEMBER
}

enum CommunicationChannel {
  EMAIL
  SMS
  PUSH
  WHATSAPP
  IN_APP
}

enum CommunicationType {
  ANNOUNCEMENT
  NEWSLETTER
  DEVOTIONAL
  EVENT
  SERMON
  PRAYER_REQUEST_RECEIVED
  PRAYER_REQUEST_ASSIGNED
  PRAYER_REQUEST_ANSWERED
  PRAYER_UPDATE
  PRAYER_TEAM_NOTE
  PRAYER_FOLLOW_UP
  THANK_YOU
  FOLLOW_UP
  EMERGENCY
  CUSTOM
}

enum CommunicationStatus {
  DRAFT
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum RecipientStatus {
  PENDING
  SENT
  FAILED
  READ
}
enum InviteRole {
  MEMBER
  ADMIN
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}
enum PrayerRequestCategory {
  HEALING
  FINANCIAL_PROVISION
  FAMILY_MARRIAGE
  SALVATION
  DELIVERANCE
  JOB
  SCHOOL
  THANKSGIVING
  OTHER
}

enum PrayerRequestVisibility {
  PRIVATE
  TEAM_ONLY
  PUBLIC
}

enum PrayerRequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum PrayerRequestStatus {
  PENDING
  ASSIGNED
  PRAYING
  ANSWERED
  CLOSED
  ARCHIVED
}
